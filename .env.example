# MongoDB Configuration
# Option 1: MongoDB Local
MONGO_URI=mongodb://localhost:27017/

# Option 2: MongoDB Atlas (Cloud - Recommandé)
# MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/credit_platform?retryWrites=true&w=majority
# Remplacez username, password, et l'URL par vos credentials MongoDB Atlas

# Gmail API Configuration
# Obtenez vos credentials depuis https://console.cloud.google.com/
# 1. Créer un projet
# 2. Activer Gmail API
# 3. Créer des credentials OAuth 2.0
# 4. Télécharger le fichier JSON et le renommer en credentials.json

# WhatsApp Business API Configuration
# Obtenez ces informations depuis Meta Business Suite
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_verify_token_for_webhook

# Banking Platform API Configuration
# Adaptez selon votre plateforme bancaire
BANK_API_URL=https://api.bank.example.com/v1
BANK_API_KEY=your_bank_api_key
BANK_API_SECRET=your_bank_api_secret

