generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Client {
  id                  Int       @id @default(autoincrement())
  email               String?   @unique // Added for email matching
  typeClient          String    // individu or pme
  nom                 String?
  prenom              String?
  compte_courant      String?
  duree_mois          Int?
  historique_credit   String?
  objectif_credit     String?
  montant_credit      Float?
  epargne             Float?
  emploi              String?
  emploi_depuis       Int?
  taux_remboursement  Float?
  statut_personnel    String?
  garants             String?
  residence_depuis    Int?
  patrimoine          Float?
  age                 Int?
  autres_credits      String?
  logement            String?
  nb_credits_banque   Int?
  personnes_a_charge  Int?
  telephone           String?
  travailleur_etranger Boolean?
  classe              String? // bon client / mauvais client
  decision_ia         String? // donner / refuser
  decision_analyste   String? // donner / refuser
  difference_ia_analyste Boolean? // true if different

  documents           Document[]
  emails              Email[]
  vocaux              Vocal[]
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Standard Documents Status (Links/Paths or null)
  doc_identite        String? // Identité : CIN ou Passeport
  doc_demande_credit  String? // Demande de crédit (Individuel)
  doc_bulletin_bancaire String? // Bulletin bancaire : Justificatif de revenus/statut
  doc_releves_bancaires String? // Relevés bancaires
  doc_bilan           String? // Bilan
  doc_facture_domicile String? // Domicile : facture eau/élec
  doc_registre_commerce String? // PME
  doc_matricule_fiscal String? // PME
  doc_compte_resultat String? // PME
  doc_demande_credit_pme String? // PME
  doc_cin_dirigeant   String? // PME
}

model Document {
  id          Int      @id @default(autoincrement())
  client      Client   @relation(fields: [clientId], references: [id])
  clientId    Int
  email       Email?   @relation(fields: [emailId], references: [id])
  emailId     Int?
  type        String   // CIN, passport, etc.
  url         String   // path to file
  ocrScore    Float?   // % OCR correction
  clipScore   Float?   // % CLIP score
  statut      String?  // valide, en_attente, rejete
  commentaire String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Email {
  id        Int      @id @default(autoincrement())
  messageId String?  @unique // Gmail Message ID for deduping
  client    Client?  @relation(fields: [clientId], references: [id]) // Optional for unmatched
  clientId  Int?
  
  subject   String
  sender    String   // Added sender
  body      String   @db.Text // Ensure enough space
  sentAt    DateTime @default(now())
  status    String?  // processed, unmatched, etc.
  
  attachments Document[]

  // AI Analysis Fields
  intention       String?
  confiance       Float?
  ton_urgence     Float?    @default(0)
  ton_stress      Float?    @default(0)
  ton_serieux     Float?    @default(0)
  
  extractedData   Json?     // Store structured data (amount, credit_type, etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vocal {
  id        Int      @id @default(autoincrement())
  client    Client   @relation(fields: [clientId], references: [id])
  clientId  Int
  url       String
  type      String?
  duration  Int?
  createdAt DateTime @default(now())
}

model Analyst {
  id        Int      @id @default(autoincrement())
  nom       String
  prenom    String
  email     String   @unique
  password  String   // Haché
  role      String   @default("analyst") // analyst, admin, etc.
  bank      String?  // Name of the bank (BIAT, BNA, etc.)
  
  // Real-time status logic
  lastSeen  DateTime @default(now())

  // Messaging relations
  messagesSent     AnalystMessage[] @relation("SentMessages")
  messagesReceived AnalystMessage[] @relation("ReceivedMessages")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnalystMessage {
  id          Int      @id @default(autoincrement())
  content     String   @db.Text
  sender      Analyst  @relation("SentMessages", fields: [senderId], references: [id])
  senderId    Int
  receiver    Analyst  @relation("ReceivedMessages", fields: [receiverId], references: [id])
  receiverId  Int
  createdAt   DateTime @default(now())
  read        Boolean  @default(false)
}
